# Скопируйте в .env для запуска API с PostgreSQL.
# Без DATABASE_URL API работает на in-memory репозитории (zero-config dev).
DATABASE_URL=postgres://lifeos:lifeos@localhost:5433/lifeos
PORT=3011

# Секреты аутентификации. В проде — из секрет-менеджера/KMS, НЕ в репозитории.
JWT_SECRET=change-me-in-production
ENCRYPTION_KEY=change-me-in-production

# Опционально: включает реальный ИИ-провайдер Claude (иначе — Noop, без внешних вызовов).
# ANTHROPIC_API_KEY=sk-ant-...

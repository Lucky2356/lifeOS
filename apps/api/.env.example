# Скопируйте в .env. Все переменные опциональны — API поднимется и без них.

# База данных. Без DATABASE_URL — in-memory (данные не сохраняются, только для разработки).
# С DATABASE_URL миграции применяются автоматически при старте.
DATABASE_URL=postgres://lifeos:lifeos@localhost:5433/lifeos
PORT=3011

# Секреты аутентификации/шифрования. Можно НЕ задавать: при пустых значениях API сгенерирует
# стойкие случайные и сохранит их в БД (уникально на установку). Задайте свои, если нужен
# явный контроль (напр. общий секрет для нескольких инстансов). Пример: openssl rand -hex 32
# JWT_SECRET=
# ENCRYPTION_KEY=

# Ротация ключей шифрования (необязательно). Упорядоченный набор "id:material" через запятую;
# ПЕРВЫЙ — текущий (им шифруются новые данные), остальные — прежние (для чтения старых записей по
# их keyId). Идентификаторы — из [A-Za-z0-9_-]. Пример ротации: сгенерировать новый ключ, поставить
# его первым, старый оставить, затем прогнать перешифровку: POST /api/v1/admin/rotate-keys
# (нужен ENABLE_DEV_ENDPOINTS=true). Если не задан — используется одиночный ENCRYPTION_KEY под id v1.
# ENCRYPTION_KEYS=v2:НОВЫЙ_КЛЮЧ,v1:ПРЕЖНИЙ_КЛЮЧ

# CORS. По умолчанию origin отражается (auth на Bearer-токенах). Для ужесточения — список
# разрешённых origin через запятую (нативные приложения tauri/capacitor разрешаются всегда).
# ALLOWED_ORIGINS=https://lifeos.example.com

# Адрес веб-приложения — для ссылок сброса пароля в письмах.
APP_URL=http://localhost:8080

# Dev/админ-эндпоинты (напр. POST /reminder/run — ручная рассылка ВСЕМ). В проде держите выключенным.
# ENABLE_DEV_ENDPOINTS=true

# Каталог для зашифрованных вложений (сканы/PDF документов). По умолчанию — папка рядом с API.
# ATTACHMENTS_DIR=/data/attachments

# SMTP для писем (сброс пароля). Без этих переменных письма не отправляются (ссылка пишется в лог).
# Бесплатный вариант — Brevo: зарегистрируйтесь, раздел SMTP & API возьмите хост/логин/ключ.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=ваш-логин@brevo
# SMTP_PASS=ваш-smtp-ключ
# SMTP_FROM=Life OS <no-reply@ваш-домен>


# ИИ — опциональный слой. Без ключей провайдер = Noop (внешних вызовов нет, всё работает вручную).
# Задайте ключ того провайдера, который выбран в настройках приложения.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_MODEL=deepseek-chat
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.0-flash
# Любой OpenAI-совместимый (Groq/Mistral/OpenRouter/локальный Ollama):
# AI_CUSTOM_BASE_URL=http://localhost:11434/v1
# AI_CUSTOM_API_KEY=
# AI_CUSTOM_MODEL=llama3.1
